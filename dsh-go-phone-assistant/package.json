{
  "name": "dsh-go-phone-assistant",
  "version": "1.0.0",
  "description": "dsh-go 手机助手插件：直接用 dsh-go 自带的手机操控读屏、点按、输入、开应用，带长期记忆、语音优先、步骤播报和可自定义文案（不依赖任何第三方 App）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-go",
    "dsh-go-plugin",
    "phone",
    "automation",
    "android",
    "assistant",
    "memory"
  ],
  "author": {
    "name": "Fangshuming-star",
    "url": "https://github.com/Fangshuming-star"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "market"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fangshuming-star/Deepseek-Mobile-voice-assistant-Plugin-for-DSH-GO.git"
  },
  "homepage": "https://github.com/Fangshuming-star/Deepseek-Mobile-voice-assistant-Plugin-for-DSH-GO#readme",
  "bugs": {
    "url": "https://github.com/Fangshuming-star/Deepseek-Mobile-voice-assistant-Plugin-for-DSH-GO/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "手机助手",
      "en": "Phone assistant"
    },
    "icon": "robot",
    "capabilities": [
      "micro",
      "overlay"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "hey-fishy",
          "label": {
            "zh": "叫助手",
            "en": "Hey"
          },
          "icon": "mic"
        },
        {
          "id": "memory-open",
          "label": {
            "zh": "记忆",
            "en": "Memory"
          },
          "icon": "book"
        }
      ],
      "composer.strip": [
        {
          "id": "island",
          "icon": "robot",
          "text": {
            "zh": "助手在",
            "en": "Assistant"
          },
          "panel": "jarvis"
        }
      ],
      "composer.tools": [
        {
          "id": "screen-read",
          "label": {
            "zh": "读屏",
            "en": "Screen"
          },
          "icon": "phone"
        },
        {
          "id": "skill-run",
          "label": {
            "zh": "快捷指令",
            "en": "Skill"
          },
          "icon": "bolt",
          "panel": "skills"
        }
      ],
      "panels": [
        {
          "id": "jarvis",
          "title": {
            "zh": "手机助手",
            "en": "Phone assistant"
          },
          "icon": "robot",
          "placement": [
            "chat.panel",
            "session.tab",
            "features"
          ],
          "micro": "caption"
        },
        {
          "id": "memory",
          "title": {
            "zh": "记忆",
            "en": "Memory"
          },
          "icon": "book",
          "placement": [
            "session.tab",
            "features"
          ]
        },
        {
          "id": "skills",
          "title": {
            "zh": "快捷指令",
            "en": "Skills"
          },
          "icon": "bolt",
          "placement": [
            "chat.panel",
            "features"
          ]
        },
        {
          "id": "settings",
          "title": {
            "zh": "助手设置",
            "en": "Settings"
          },
          "icon": "settings",
          "placement": [
            "features",
            "session.tab"
          ]
        }
      ],
      "micro": [
        {
          "id": "caption"
        }
      ],
      "overlays": [
        {
          "id": "subtitle",
          "channel": "caption",
          "text": "助手在听"
        }
      ],
      "message.actions": [
        {
          "id": "do-it",
          "label": {
            "zh": "照这条办",
            "en": "Do this"
          },
          "icon": "play"
        },
        {
          "id": "memory-save",
          "label": {
            "zh": "记住这条",
            "en": "Remember"
          },
          "icon": "bookmark"
        }
      ],
      "session.actions": [
        {
          "id": "screen",
          "label": {
            "zh": "读一屏",
            "en": "Read screen"
          },
          "icon": "phone"
        },
        {
          "id": "wipe",
          "label": {
            "zh": "清空记忆",
            "en": "Wipe memory"
          },
          "icon": "clear"
        }
      ],
      "turn.note": [
        {
          "id": "steps"
        }
      ]
    },
    "wants": [
      "message"
    ]
  }
}